# =============================================================================
# AI QQ 群机器人 - 配置模板
# =============================================================================
# 使用方法：
#   1. 把本文件复制一份，命名为 .env     （命令： copy .env.example .env ）
#   2. 按下面的说明填写真实值
#   3. 千万不要把填好的 .env 提交到 GitHub（.gitignore 已经帮你排除了）
#
# 注意：等号两边不要加空格，值不要加引号。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、机器人自身
# -----------------------------------------------------------------------------
# 机器人名字，只用于日志和提示文案
BOT_NAME=玛奇玛

# 超级管理员 QQ 号。**没有就写 []（不要留空）**
# 单个：SUPERUSERS=["123456"]
# 多个：SUPERUSERS=["123456","789012"]
# ⚠️ 留空写成 "SUPERUSERS=" 会让 NoneBot 解析失败、机器人无法启动
SUPERUSERS=[]

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 异步写日志（需要进程间管道，部分受限环境会报 WinError 5，默认关闭）
LOG_ASYNC=false

# -----------------------------------------------------------------------------
# 二、连接 NapCat（OneBot V11）
# -----------------------------------------------------------------------------
# 监听地址：默认只监听本机，不要改成 0.0.0.0（会把管理端口暴露到公网）
HOST=127.0.0.1
PORT=8080

# 访问令牌：必须和 NapCat 里「网络配置 -> 反向 WebSocket」中填的 Token 完全一致。
# 留空表示不校验（不安全，仅建议本机测试时使用）。
# 生成方法（PowerShell）： -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
ONEBOT_ACCESS_TOKEN=change-me-to-a-random-token

# 正向 WebSocket 地址（本项目默认用反向 WS，一般保持为空）
ONEBOT_WS_URLS=[]

# -----------------------------------------------------------------------------
# 三、DeepSeek AI
# -----------------------------------------------------------------------------
# 到 https://platform.deepseek.com/api_keys 创建，形如 sk-xxxxxxxx
AI_API_KEY=sk-替换成你自己的Key

# API 地址（一般不用改）
AI_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-chat（通用对话） / deepseek-reasoner（推理模型，更贵更慢）
AI_MODEL=deepseek-chat

# 单次请求超时时间（秒）
AI_TIMEOUT=60
# 失败自动重试次数（0-5）
AI_MAX_RETRIES=2
# 生成温度：0 最稳定，2 最发散
AI_TEMPERATURE=0.7
# 单次回答最多生成多少 token（直接决定费用）
AI_MAX_TOKENS=800
# 机器人人设。两种写法，优先级：内联 > 文件 > 代码内置兜底
#   1) 人设文件（推荐：长提示词好维护，直接编辑 personas/makima.txt）
#   2) 内联写法：把提示词直接写在 AI_SYSTEM_PROMPT= 后面（不换行），会覆盖文件
AI_SYSTEM_PROMPT=
AI_SYSTEM_PROMPT_FILE=personas/makima.txt

# -----------------------------------------------------------------------------
# 四、上下文与频率限制
# -----------------------------------------------------------------------------
# 记住最近多少轮对话（1 轮 = 你问一次 + AI 答一次）
HISTORY_MAX_TURNS=5
# 历史存储方式：memory（重启清空） / sqlite（写入文件，重启保留）
HISTORY_BACKEND=memory
# sqlite 模式下的数据库位置，留空表示用默认的 data/history.db
HISTORY_DB_PATH=

# 单个问题最大长度（字符）
MAX_QUESTION_LENGTH=1000
# 单条回复最大长度（字符），超出会截断
MAX_REPLY_LENGTH=1000

# 同一用户在同一群的请求冷却时间（秒），0 表示不限制
COOLDOWN_SECONDS=5

# -----------------------------------------------------------------------------
# 五、NoneBot 框架设置
# -----------------------------------------------------------------------------
# 驱动器：反向 WebSocket 需要 websockets
DRIVER=~fastapi+~websockets
# 进程内环境名
ENVIRONMENT=prod
# 命令前缀（一般保持默认）
COMMAND_START=["/"]
